// Windows version resource of @XXYARA_RC_ORIGINAL_FILENAME@, generated by CMake
// from src/xxyara_version.rc.in. It changes no program output.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @XXYARA_RC_FILETYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Based on YARA-X by Victor M. Alvarez"
            VALUE "CompanyName", "hors"
            VALUE "FileDescription", "@XXYARA_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@XXYARA_RC_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 hors"
            VALUE "OriginalFilename", "@XXYARA_RC_ORIGINAL_FILENAME@"
            VALUE "ProductName", "xxyara"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
